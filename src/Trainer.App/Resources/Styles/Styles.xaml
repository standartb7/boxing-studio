    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="Shell.DisabledColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="Shell.UnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray200}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}" />
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource White}}" />
        <Setter Property="UnselectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />
        <Setter Property="SelectedTabColor" Value="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>

    <!-- ===============================================================
         Underground Redesign 2026 — reusable styles.
         Naming: Ug* prefix to avoid clashing with the legacy theme.
         =============================================================== -->

    <!-- Tiny mono label: section headers, subtitles, meta lines. -->
    <Style x:Key="UgMono" TargetType="Label">
        <Setter Property="FontFamily" Value="JetBrainsMono" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{StaticResource UgInkSoft}" />
        <Setter Property="CharacterSpacing" Value="1.5" />
    </Style>

    <Style x:Key="UgMonoBold" TargetType="Label" BasedOn="{StaticResource UgMono}">
        <Setter Property="FontFamily" Value="JetBrainsMonoBold" />
        <Setter Property="TextColor" Value="{StaticResource UgInk}" />
    </Style>

    <!-- Big condensed display heading (Bebas). Sized at the call site. -->
    <Style x:Key="UgDisplay" TargetType="Label">
        <Setter Property="FontFamily" Value="BebasNeue" />
        <Setter Property="FontSize" Value="64" />
        <Setter Property="TextColor" Value="{StaticResource UgInk}" />
        <Setter Property="LineHeight" Value="0.92" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <!-- Bebas at body-section sizes (e.g. "ВСЕ ГРУППЫ", "TODAY'S CARD"). -->
    <Style x:Key="UgSectionTitle" TargetType="Label" BasedOn="{StaticResource UgDisplay}">
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!-- Card on paper bg: paper fill, dark hairline border. -->
    <Style x:Key="UgCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource UgPaper}" />
        <Setter Property="Stroke" Value="{StaticResource UgInk}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Slightly recessed row (used in the numbered list). -->
    <Style x:Key="UgRowCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource UgPaperDeep}" />
        <Setter Property="Stroke" Value="{StaticResource UgInk}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- Big red CTA — the "ЗАПИСАТЬ В РИНГ" / "+ НОВЫЙ КЛИЕНТ" button. -->
    <Style x:Key="UgPrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="BebasNeue" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="BackgroundColor" Value="{StaticResource UgBlood}" />
        <Setter Property="TextColor" Value="{StaticResource UgPaper}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource UgBloodDeep}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource UgInkMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Ghost / secondary button: paper bg, dark border, mono text. -->
    <Style x:Key="UgGhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="JetBrainsMonoBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="BackgroundColor" Value="{StaticResource UgPaper}" />
        <Setter Property="TextColor" Value="{StaticResource UgInk}" />
        <Setter Property="BorderColor" Value="{StaticResource UgInk}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinimumHeightRequest" Value="36" />
    </Style>

    <!-- Form fields on paper background. -->
    <Style x:Key="UgEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="JetBrainsMono" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource UgInk}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource UgInkMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="UgEditor" TargetType="Editor">
        <Setter Property="FontFamily" Value="JetBrainsMono" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource UgInk}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource UgInkMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!-- Field-label above an input: small mono caption. -->
    <Style x:Key="UgFieldLabel" TargetType="Label" BasedOn="{StaticResource UgMono}">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="TextColor" Value="{StaticResource UgInkSoft}" />
    </Style>

    <!-- Container that wraps an Entry to draw the form-field box. -->
    <Style x:Key="UgFieldBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource UgPaper}" />
        <Setter Property="Stroke" Value="{StaticResource UgInk}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <!-- Padding for the dark top mono strip. iOS needs extra top to clear the status
         bar / notch (pages opt out of safe area so the strip itself fills to the very
         top of the screen). Other platforms don't need it. -->
    <OnPlatform x:Key="UgTopStripPadding" x:TypeArguments="Thickness">
        <On Platform="iOS" Value="16,54,16,10" />
        <On Platform="MacCatalyst" Value="16,12,16,10" />
        <On Platform="Android" Value="16,32,16,10" />
        <On Platform="WinUI" Value="16,12,16,10" />
    </OnPlatform>

    <!-- Padding for the bottom action bar — pushes the button above the home indicator. -->
    <OnPlatform x:Key="UgBottomBarPadding" x:TypeArguments="Thickness">
        <On Platform="iOS" Value="16,10,16,30" />
        <On Platform="MacCatalyst" Value="16,10,16,16" />
        <On Platform="Android" Value="16,10,16,18" />
        <On Platform="WinUI" Value="16,10,16,16" />
    </OnPlatform>

    <!-- Bottom padding for ScrollView content on pages without a fixed bottom bar. -->
    <OnPlatform x:Key="UgScrollBottomPadding" x:TypeArguments="Thickness">
        <On Platform="iOS" Value="0,0,0,30" />
        <On Platform="MacCatalyst" Value="0,0,0,12" />
        <On Platform="Android" Value="0,0,0,16" />
        <On Platform="WinUI" Value="0,0,0,12" />
    </OnPlatform>

</ResourceDictionary>
