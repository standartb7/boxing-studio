<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contracts="clr-namespace:Trainer.Contracts;assembly=Trainer.Contracts"
             x:Class="Trainer.App.Pages.TrainerManagementPage"
             Title="Тренеры"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1A}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Label Grid.Row="0"
               Text="Главный тренер видит клиентов всех тренеров. Обычный тренер — только своих."
               Padding="16,12"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#666, Dark=#bbb}" />

        <CollectionView x:Name="UsersList"
                        Grid.Row="1"
                        Margin="12,0,12,12">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6" Padding="24">
                    <Label Text="Пока нет тренеров" FontSize="16" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="contracts:UserDto">
                    <Border Padding="14"
                            Margin="0,4"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#ddd, Dark=#444}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUserTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Email}" FontSize="12" TextColor="{AppThemeBinding Light=#666, Dark=#aaa}" />
                                <Label Text="{Binding Role}" FontSize="11" FontAttributes="Italic" TextColor="{AppThemeBinding Light=#888, Dark=#bbb}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="1"
                                   Text="неактивен"
                                   FontSize="11"
                                   VerticalOptions="Center"
                                   TextColor="#D9534F">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                x:Name="InviteBtn"
                Text="+ Пригласить тренера"
                Margin="16,8,16,16"
                Clicked="OnInviteClicked" />
    </Grid>
</ContentPage>
