<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contracts="clr-namespace:Trainer.Contracts;assembly=Trainer.Contracts"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Trainer.App.Pages.TrainerManagementPage"
             NavigationPage.HasNavigationBar="False"
             ios:Page.UseSafeArea="False"
             BackgroundColor="{StaticResource UgPaper}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Top dark strip with back -->
        <Grid Grid.Row="0"
              Padding="{StaticResource UgTopStripPadding}"
              ColumnDefinitions="Auto,*"
              BackgroundColor="{StaticResource UgInk}">
            <Button Grid.Column="0"
                    Text="← НАЗАД"
                    FontFamily="JetBrainsMonoBold"
                    FontSize="9"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource UgPaper}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0,0,12,0"
                    MinimumHeightRequest="22"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   FontFamily="JetBrainsMono"
                   FontSize="9"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource UgPaper}"
                   VerticalOptions="Center"
                   Text="ADMIN  •  CORNERMEN ROSTER  •  NO. 03" />
        </Grid>

        <!-- Hero + hint -->
        <VerticalStackLayout Grid.Row="1" Padding="20,16,20,12" Spacing="4">
            <Label Style="{StaticResource UgMono}" Text="УПРАВЛЕНИЕ КОМАНДОЙ · ADMIN" />
            <Label Style="{StaticResource UgDisplay}"
                   FontSize="44"
                   Text="ТРЕНЕРЫ" />
            <Label Style="{StaticResource UgMono}"
                   FontSize="10"
                   LineHeight="1.4"
                   Margin="0,4,0,0"
                   Text="ГЛАВНЫЙ ТРЕНЕР ВИДИТ КЛИЕНТОВ ВСЕХ ТРЕНЕРОВ. ОБЫЧНЫЙ ТРЕНЕР — ТОЛЬКО СВОИХ." />
        </VerticalStackLayout>

        <!-- Trainers list -->
        <CollectionView x:Name="UsersList"
                        Grid.Row="2"
                        Margin="0,0,0,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="24">
                    <Label Text="ПОКА НЕТ ТРЕНЕРОВ"
                           FontFamily="BebasNeue"
                           FontSize="32"
                           CharacterSpacing="1"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource UgInk}" />
                    <Label Style="{StaticResource UgMono}"
                           Text="НАЖМИ «+ ПРИГЛАСИТЬ» ВНИЗУ"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="contracts:UserDto">
                    <Border BackgroundColor="{StaticResource UgPaper}"
                            StrokeThickness="0"
                            Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUserTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8"
                              Padding="16,14,16,14">
                            <BoxView Grid.ColumnSpan="2"
                                     HeightRequest="1"
                                     Color="{StaticResource UgInk}"
                                     VerticalOptions="Start"
                                     Margin="-16,0,-16,0"
                                     Opacity="0.35" />

                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}"
                                       FontFamily="BebasNeue"
                                       FontSize="18"
                                       CharacterSpacing="0.5"
                                       LineBreakMode="WordWrap"
                                       TextColor="{StaticResource UgInk}" />
                                <Label Text="{Binding Email}"
                                       FontFamily="JetBrainsMono"
                                       FontSize="10"
                                       CharacterSpacing="0.8"
                                       TextColor="{StaticResource UgInkMuted}" />
                                <Label Text="{Binding Role, StringFormat='◆ {0}'}"
                                       FontFamily="JetBrainsMonoBold"
                                       FontSize="9"
                                       CharacterSpacing="1.2"
                                       TextColor="{StaticResource UgBlood}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Padding="6,2"
                                    BackgroundColor="{StaticResource UgBlood}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Label Text="НЕАКТИВЕН"
                                       FontFamily="JetBrainsMonoBold"
                                       FontSize="9"
                                       CharacterSpacing="1.0"
                                       TextColor="{StaticResource UgPaper}" />
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom action bar -->
        <Border Grid.Row="3"
                Padding="{StaticResource UgBottomBarPadding}"
                BackgroundColor="{StaticResource UgPaper}"
                StrokeThickness="0">
            <Button x:Name="InviteBtn"
                    Style="{StaticResource UgPrimaryButton}"
                    Text="+ ПРИГЛАСИТЬ ТРЕНЕРА"
                    Clicked="OnInviteClicked" />
        </Border>
    </Grid>
</ContentPage>
