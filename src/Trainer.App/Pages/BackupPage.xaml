<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trainer.App.Pages.BackupPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource UgPaper}">

    <Grid RowDefinitions="Auto,*">

        <!-- Top dark strip with back -->
        <Grid Grid.Row="0"
              Padding="16,12,16,10"
              ColumnDefinitions="Auto,*"
              BackgroundColor="{StaticResource UgInk}">
            <Button Grid.Column="0"
                    Text="← НАЗАД"
                    FontFamily="JetBrainsMonoBold"
                    FontSize="9"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource UgPaper}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0,0,12,0"
                    MinimumHeightRequest="22"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   FontFamily="JetBrainsMono"
                   FontSize="9"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource UgPaper}"
                   VerticalOptions="Center"
                   Text="STUDIO  •  SETTINGS  •  CONTROL ROOM" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,20" Spacing="14">

                <!-- ============== ACCOUNT HERO ============== -->
                <Label Style="{StaticResource UgMono}" Text="ТЕКУЩИЙ ПОЛЬЗОВАТЕЛЬ · ACCOUNT" />
                <Label Style="{StaticResource UgDisplay}"
                       FontSize="48"
                       Text="НАСТРОЙКИ" />

                <BoxView HeightRequest="1" Color="{StaticResource UgInk}" Margin="0,4,0,8" />

                <!-- Account info row -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            BackgroundColor="{StaticResource UgInk}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            VerticalOptions="Center">
                        <Label x:Name="AccountInitialsLabel"
                               FontFamily="JetBrainsMonoBold"
                               FontSize="14"
                               TextColor="{StaticResource UgPaper}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Text="—" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="AccountLabel"
                               FontFamily="BebasNeue"
                               FontSize="22"
                               CharacterSpacing="0.5"
                               TextColor="{StaticResource UgInk}"
                               Text="—" />
                        <Label x:Name="AccountRoleLabel"
                               FontFamily="JetBrainsMonoBold"
                               FontSize="10"
                               CharacterSpacing="1.2"
                               TextColor="{StaticResource UgBlood}"
                               Text="—" />
                    </VerticalStackLayout>
                </Grid>

                <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" Margin="0,8,0,0">
                    <FlexLayout.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource UgGhostButton}">
                            <Setter Property="Margin" Value="0,0,6,6" />
                        </Style>
                    </FlexLayout.Resources>
                    <Button x:Name="TrainersBtn"
                            Text="◆ ТРЕНЕРЫ"
                            Clicked="OnManageTrainersClicked"
                            IsVisible="False" />
                    <Button x:Name="ChangePasswordBtn"
                            Text="◆ СМЕНИТЬ ПАРОЛЬ"
                            Clicked="OnChangePasswordClicked" />
                    <Button x:Name="SignOutBtn"
                            Text="◆ ВЫЙТИ"
                            TextColor="{StaticResource UgBlood}"
                            BorderColor="{StaticResource UgBlood}"
                            Clicked="OnSignOutClicked" />
                </FlexLayout>

                <!-- ============== BIOMETRIC SECTION ============== -->
                <VerticalStackLayout x:Name="BiometricSection" Spacing="8" Margin="0,16,0,0" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0"
                               Style="{StaticResource UgSectionTitle}"
                               FontSize="22"
                               Text="БЕЗОПАСНОСТЬ"
                               VerticalOptions="Center" />
                        <BoxView Grid.Column="1"
                                 HeightRequest="1"
                                 Color="{StaticResource UgInk}"
                                 VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Style="{StaticResource UgMono}"
                               FontSize="9"
                               VerticalOptions="Center"
                               Text="SECURITY" />
                    </Grid>

                    <Border Style="{StaticResource UgCard}" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto" RowSpacing="2">
                            <Label Grid.Column="0"
                                   x:Name="BiometricLabel"
                                   FontFamily="JetBrainsMonoBold"
                                   FontSize="13"
                                   CharacterSpacing="0.5"
                                   VerticalOptions="Center"
                                   TextColor="{StaticResource UgInk}"
                                   Text="FACE ID ДЛЯ ВХОДА" />
                            <Switch Grid.Column="1"
                                    x:Name="BiometricSwitch"
                                    OnColor="{StaticResource UgBlood}"
                                    ThumbColor="{StaticResource UgPaper}"
                                    Toggled="OnBiometricToggled" />
                        </Grid>
                    </Border>
                    <Label x:Name="BiometricHint"
                           Style="{StaticResource UgMono}"
                           FontSize="10"
                           CharacterSpacing="0.8"
                           LineHeight="1.4" />
                </VerticalStackLayout>

                <!-- ============== EXPORT ============== -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,16,0,0">
                    <Label Grid.Column="0"
                           Style="{StaticResource UgSectionTitle}"
                           FontSize="22"
                           Text="ЭКСПОРТ"
                           VerticalOptions="Center" />
                    <BoxView Grid.Column="1"
                             HeightRequest="1"
                             Color="{StaticResource UgInk}"
                             VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Style="{StaticResource UgMono}"
                           FontSize="9"
                           VerticalOptions="Center"
                           Text="BACKUP" />
                </Grid>
                <Label Style="{StaticResource UgMono}"
                       FontSize="10"
                       LineHeight="1.4"
                       Text="СОХРАНИ ВСЕ ГРУППЫ, КЛИЕНТОВ И СЕССИИ В ОДИН ФАЙЛ. МОЖЕШЬ ОТПРАВИТЬ ЕГО СЕБЕ НА ПОЧТУ, В ОБЛАКО ИЛИ AIRDROP — ПОТОМ ВОССТАНОВИШЬ НА НОВОМ ТЕЛЕФОНЕ." />
                <Button x:Name="ExportBtn"
                        Style="{StaticResource UgPrimaryButton}"
                        Text="↓ ЭКСПОРТИРОВАТЬ ДАННЫЕ"
                        Clicked="OnExportClicked" />

                <!-- ============== IMPORT ============== -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,16,0,0">
                    <Label Grid.Column="0"
                           Style="{StaticResource UgSectionTitle}"
                           FontSize="22"
                           Text="ИМПОРТ"
                           VerticalOptions="Center" />
                    <BoxView Grid.Column="1"
                             HeightRequest="1"
                             Color="{StaticResource UgInk}"
                             VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Style="{StaticResource UgMono}"
                           FontSize="9"
                           VerticalOptions="Center"
                           Text="RESTORE" />
                </Grid>
                <!-- Warning tape -->
                <Border Padding="10,8"
                        BackgroundColor="{StaticResource UgTape}"
                        StrokeThickness="0"
                        HorizontalOptions="Start">
                    <Label FontFamily="JetBrainsMonoBold"
                           FontSize="10"
                           CharacterSpacing="1.0"
                           TextColor="{StaticResource UgInk}"
                           Text="⚠ ВНИМАНИЕ · ЗАМЕНЯЕТ ВСЕ ДАННЫЕ" />
                </Border>
                <Label Style="{StaticResource UgMono}"
                       FontSize="10"
                       LineHeight="1.4"
                       Text="ЗАГРУЗИ ФАЙЛ БЭКАПА. ВСЕ ТЕКУЩИЕ ДАННЫЕ БУДУТ ЗАМЕНЕНЫ НА ДАННЫЕ ИЗ ФАЙЛА." />
                <Button x:Name="ImportBtn"
                        Style="{StaticResource UgGhostButton}"
                        Text="↑ ИМПОРТИРОВАТЬ ИЗ ФАЙЛА"
                        Clicked="OnImportClicked" />

                <Label x:Name="StatusLabel"
                       FontFamily="JetBrainsMonoBold"
                       FontSize="11"
                       CharacterSpacing="0.8"
                       TextColor="{StaticResource UgInk}"
                       Margin="0,8,0,0"
                       IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
