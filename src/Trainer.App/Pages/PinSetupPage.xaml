<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trainer.App.Pages.PinSetupPage"
             Title="Установка PIN"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Image Source="logo.png"
                   HeightRequest="140"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="Придумай PIN-код (4 цифры)"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <Entry x:Name="PinEntry"
                   Placeholder="••••"
                   Keyboard="Numeric"
                   MaxLength="4"
                   IsPassword="True"
                   HorizontalTextAlignment="Center"
                   FontSize="22" />

            <Entry x:Name="ConfirmEntry"
                   Placeholder="Повтори PIN"
                   Keyboard="Numeric"
                   MaxLength="4"
                   IsPassword="True"
                   HorizontalTextAlignment="Center"
                   FontSize="22" />

            <Label x:Name="ErrorLabel"
                   TextColor="Red"
                   FontSize="13"
                   IsVisible="False" />

            <Button x:Name="SaveBtn"
                    Text="Сохранить"
                    Style="{StaticResource AccentButton}"
                    Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
