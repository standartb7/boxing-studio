<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Trainer.App.Pages.PinSetupPage"
             NavigationPage.HasNavigationBar="False"
             ios:Page.UseSafeArea="False"
             BackgroundColor="{StaticResource UgPaper}">

    <Grid RowDefinitions="Auto,*">

        <!-- Top dark mono strip -->
        <Grid Grid.Row="0"
              Padding="{StaticResource UgTopStripPadding}"
              BackgroundColor="{StaticResource UgInk}">
            <Label FontFamily="JetBrainsMono"
                   FontSize="9"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource UgPaper}"
                   VerticalOptions="Center"
                   Text="EST. MMXIX  •  BOXING STUDIO  •  PIN SETUP  •  STEP 02" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,40"
                                 Spacing="14"
                                 MaximumWidthRequest="420"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <Label Style="{StaticResource UgMono}"
                       Text="БЫСТРЫЙ ВХОД · QUICK ACCESS"
                       HorizontalOptions="Center" />
                <Label Style="{StaticResource UgDisplay}"
                       FontSize="56"
                       HorizontalOptions="Center"
                       Text="SET PIN" />
                <Label Style="{StaticResource UgMono}"
                       Text="ПРИДУМАЙ 4 ЦИФРЫ ДЛЯ БЫСТРОГО ВХОДА"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       Margin="0,4,0,12" />

                <Label Style="{StaticResource UgFieldLabel}" Text="PIN-КОД · 4 ЦИФРЫ" />
                <Border Style="{StaticResource UgFieldBorder}">
                    <Entry x:Name="PinEntry"
                           Style="{StaticResource UgEntry}"
                           Placeholder="• • • •"
                           Keyboard="Numeric"
                           MaxLength="4"
                           IsPassword="True"
                           HorizontalTextAlignment="Center"
                           FontSize="22"
                           CharacterSpacing="6" />
                </Border>

                <Label Style="{StaticResource UgFieldLabel}"
                       Text="ПОВТОРИ PIN · CONFIRM"
                       Margin="0,6,0,0" />
                <Border Style="{StaticResource UgFieldBorder}">
                    <Entry x:Name="ConfirmEntry"
                           Style="{StaticResource UgEntry}"
                           Placeholder="• • • •"
                           Keyboard="Numeric"
                           MaxLength="4"
                           IsPassword="True"
                           HorizontalTextAlignment="Center"
                           FontSize="22"
                           CharacterSpacing="6" />
                </Border>

                <Label x:Name="ErrorLabel"
                       FontFamily="JetBrainsMonoBold"
                       FontSize="11"
                       CharacterSpacing="0.8"
                       TextColor="{StaticResource UgBlood}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />

                <Button x:Name="SaveBtn"
                        Style="{StaticResource UgPrimaryButton}"
                        Text="✷ СОХРАНИТЬ PIN ✷"
                        Clicked="OnSaveClicked"
                        Margin="0,12,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
