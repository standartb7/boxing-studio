<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Trainer.App.ViewModels"
             x:Class="Trainer.App.Pages.GroupsPage"
             Title="Группы">

    <CollectionView x:Name="GroupsList"
                    Margin="12"
                    SelectionMode="Single"
                    SelectionChanged="OnGroupSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupRow">
                <Border Padding="16"
                        Margin="0,4"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="{Binding Title}"
                               FontAttributes="Bold"
                               FontSize="17"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                        <Border Grid.Column="1"
                                Padding="10,4"
                                BackgroundColor="{StaticResource Accent}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Count}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Black}" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
