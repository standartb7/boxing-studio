<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Trainer.App.ViewModels"
             xmlns:entities="clr-namespace:Trainer.Core.Entities;assembly=Trainer.Core"
             x:Class="Trainer.App.Pages.GroupsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource UgPaper}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- ============================================================
             Row 0: dark top strip — pinned. The Settings button is
             interactive so it lives OUTSIDE CollectionView.Header
             (interactive controls inside Header glitch on iOS).
             ============================================================ -->
        <Grid Grid.Row="0"
              Padding="16,12,16,10"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{StaticResource UgInk}">
            <Label Grid.Column="0"
                   x:Name="TopStripLabel"
                   FontFamily="JetBrainsMono"
                   FontSize="9"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource UgPaper}"
                   VerticalOptions="Center"
                   Text="EST. MMXIX  •  STUDIO ROSTER  •  РЕЕСТР  •  REG. № 047" />
            <Button Grid.Column="1"
                    Text="→ НАСТРОЙКИ"
                    FontFamily="JetBrainsMonoBold"
                    FontSize="9"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource UgPaper}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="8,0"
                    MinimumHeightRequest="22"
                    Clicked="OnBackupClicked" />
        </Grid>

        <!-- Row 1: HeadTrainer trainer filter — pinned, interactive. -->
        <Border Grid.Row="1"
                x:Name="TrainerFilterBar"
                Margin="16,12,16,4"
                Padding="12,8"
                BackgroundColor="{StaticResource UgPaper}"
                Stroke="{StaticResource UgInk}"
                StrokeThickness="1"
                IsVisible="False">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Style="{StaticResource UgMonoBold}"
                       FontSize="10"
                       Text="ТРЕНЕР ▸"
                       VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        x:Name="TrainerPicker"
                        FontFamily="JetBrainsMono"
                        FontSize="13"
                        TextColor="{StaticResource UgInk}"
                        SelectedIndexChanged="OnTrainerPickerChanged" />
            </Grid>
        </Border>

        <!-- Row 2: error banner — pinned, interactive (retry button). -->
        <Border Grid.Row="2"
                x:Name="ErrorBanner"
                Margin="16,8,16,4"
                Padding="12,8"
                BackgroundColor="{StaticResource UgBlood}"
                StrokeThickness="0"
                IsVisible="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0"
                       x:Name="ErrorText"
                       FontFamily="JetBrainsMonoBold"
                       FontSize="11"
                       TextColor="{StaticResource UgPaper}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="ПОВТОР"
                        FontFamily="JetBrainsMonoBold"
                        FontSize="10"
                        CharacterSpacing="1.2"
                        Padding="10,4"
                        MinimumHeightRequest="28"
                        BackgroundColor="{StaticResource UgPaper}"
                        TextColor="{StaticResource UgInk}"
                        BorderWidth="0"
                        CornerRadius="2"
                        Clicked="OnRetryClicked" />
            </Grid>
        </Border>

        <!-- ============================================================
             Row 3: main list. Hero + Stats + Section title scroll
             together inside CollectionView.Header (decorative only).
             ============================================================ -->
        <RefreshView Grid.Row="3" x:Name="Refresher" Refreshing="OnRefreshing">
            <CollectionView x:Name="GroupsList"
                            SelectionMode="Single"
                            SelectionChanged="OnGroupSelected">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout>

                        <!-- HERO: HEAD COACH / CORNERMAN -->
                        <Border Padding="20,18,20,18"
                                BackgroundColor="{StaticResource UgPaper}"
                                StrokeThickness="0">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           x:Name="HeroRoleMonoLabel"
                                           Style="{StaticResource UgMono}"
                                           Text="ГЛАВНЫЙ ТРЕНЕР · CH/2026" />
                                    <!-- Red rotated stamp: ON DUTY · LIVE -->
                                    <Border Grid.Column="1"
                                            Padding="8,4"
                                            BackgroundColor="{StaticResource UgPaper}"
                                            Stroke="{StaticResource UgBlood}"
                                            StrokeThickness="1.5"
                                            Rotation="-4">
                                        <VerticalStackLayout Spacing="0">
                                            <Label Text="ON DUTY"
                                                   FontFamily="BebasNeue"
                                                   FontSize="16"
                                                   CharacterSpacing="1.5"
                                                   TextColor="{StaticResource UgBlood}"
                                                   HorizontalOptions="Center" />
                                            <Label Text="● LIVE"
                                                   FontFamily="JetBrainsMonoBold"
                                                   FontSize="7"
                                                   CharacterSpacing="1.2"
                                                   TextColor="{StaticResource UgBlood}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <Label x:Name="HeroDisplayLabel"
                                       Style="{StaticResource UgDisplay}"
                                       FontSize="68"
                                       Margin="0,2,0,0"
                                       Text="HEAD COACH" />

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource UgInk}"
                                         Margin="0,12,0,10" />

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            BackgroundColor="{StaticResource UgInk}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            VerticalOptions="Center">
                                        <Label x:Name="HeroInitialsLabel"
                                               Text="ВЯ"
                                               FontFamily="JetBrainsMonoBold"
                                               FontSize="10"
                                               TextColor="{StaticResource UgPaper}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label x:Name="HeroNameLabel"
                                               FontFamily="JetBrainsMonoBold"
                                               FontSize="13"
                                               CharacterSpacing="0.8"
                                               TextColor="{StaticResource UgInk}"
                                               Text="ВИКТОР ЯЛЫМОВ" />
                                        <Label x:Name="HeroSubLabel"
                                               Style="{StaticResource UgMono}"
                                               FontSize="9"
                                               Text="HEAVYWEIGHT · BOXING STUDIO" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                        <BoxView WidthRequest="1" HeightRequest="22" Color="{StaticResource UgInk}" />
                                        <BoxView WidthRequest="3" HeightRequest="22" Color="{StaticResource UgInk}" />
                                        <BoxView WidthRequest="1" HeightRequest="22" Color="{StaticResource UgInk}" />
                                        <BoxView WidthRequest="2" HeightRequest="22" Color="{StaticResource UgInk}" />
                                        <BoxView WidthRequest="1" HeightRequest="22" Color="{StaticResource UgInk}" />
                                        <BoxView WidthRequest="3" HeightRequest="22" Color="{StaticResource UgInk}" />
                                        <BoxView WidthRequest="2" HeightRequest="22" Color="{StaticResource UgInk}" />
                                        <BoxView WidthRequest="1" HeightRequest="22" Color="{StaticResource UgInk}" />
                                        <BoxView WidthRequest="2" HeightRequest="22" Color="{StaticResource UgInk}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- STATS ROW -->
                        <Grid Padding="16,8,16,12"
                              ColumnDefinitions="*,*,*"
                              ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    Padding="12,10"
                                    BackgroundColor="{StaticResource UgPaper}"
                                    Stroke="{StaticResource UgInk}"
                                    StrokeThickness="1">
                                <VerticalStackLayout Spacing="2">
                                    <Label Style="{StaticResource UgMono}" FontSize="9" Text="КЛИЕНТЫ" />
                                    <Label x:Name="StatClientsLabel"
                                           Style="{StaticResource UgDisplay}"
                                           FontSize="32"
                                           Text="—" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="12,10"
                                    BackgroundColor="{StaticResource UgInk}"
                                    Stroke="{StaticResource UgInk}"
                                    StrokeThickness="1">
                                <VerticalStackLayout Spacing="2">
                                    <Label Style="{StaticResource UgMono}"
                                           FontSize="9"
                                           TextColor="{StaticResource UgPaper}"
                                           Text="ГРУППЫ" />
                                    <Label x:Name="StatGroupsLabel"
                                           Style="{StaticResource UgDisplay}"
                                           FontSize="32"
                                           TextColor="{StaticResource UgPaper}"
                                           Text="0" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="12,10"
                                    BackgroundColor="{StaticResource UgPaper}"
                                    Stroke="{StaticResource UgInk}"
                                    StrokeThickness="1">
                                <VerticalStackLayout Spacing="2">
                                    <Label Style="{StaticResource UgMono}" FontSize="9" Text="СЕССИИ" />
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4" VerticalOptions="End">
                                        <Label Grid.Column="0"
                                               x:Name="StatSessionsLabel"
                                               Style="{StaticResource UgDisplay}"
                                               FontSize="32"
                                               Text="0" />
                                        <Label Grid.Column="1"
                                               Style="{StaticResource UgMono}"
                                               FontSize="9"
                                               VerticalOptions="End"
                                               Margin="0,0,0,6"
                                               Text="SES" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Section title with right-aligned count -->
                        <Grid Padding="16,4,16,8"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10"
                              VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Style="{StaticResource UgSectionTitle}"
                                   Text="ВСЕ ГРУППЫ" />
                            <BoxView Grid.Column="1"
                                     HeightRequest="1"
                                     Color="{StaticResource UgInk}"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   x:Name="GroupCountLabel"
                                   Style="{StaticResource UgMono}"
                                   FontSize="11"
                                   VerticalOptions="Center"
                                   Text="0 / 0" />
                        </Grid>

                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="24">
                        <Label Text="ПОКА НЕТ ГРУПП"
                               FontFamily="BebasNeue"
                               FontSize="36"
                               CharacterSpacing="1"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource UgInk}" />
                        <Label Style="{StaticResource UgMono}"
                               Text="НАЖМИ «+ НОВАЯ ГРУППА» ВНИЗУ"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupRow">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Удалить"
                                               BackgroundColor="{StaticResource UgBlood}"
                                               Invoked="OnDeleteGroupInvoked" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border BackgroundColor="{StaticResource UgPaper}"
                                    Stroke="{StaticResource UgInk}"
                                    StrokeThickness="0"
                                    Padding="0">
                                <Grid ColumnDefinitions="44,*,Auto"
                                      Padding="16,14,16,14">
                                    <BoxView Grid.ColumnSpan="3"
                                             HeightRequest="1"
                                             Color="{StaticResource UgInk}"
                                             VerticalOptions="Start"
                                             Margin="-16,0,-16,0"
                                             Opacity="0.35" />

                                    <Label Grid.Column="0"
                                           Text="{Binding RowIndex}"
                                           FontFamily="JetBrainsMono"
                                           FontSize="12"
                                           TextColor="{StaticResource UgInkMuted}"
                                           VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Type.Name}"
                                               FontFamily="BebasNeue"
                                               FontSize="18"
                                               CharacterSpacing="0.5"
                                               LineBreakMode="WordWrap"
                                               TextColor="{StaticResource UgInk}" />
                                        <Label Text="{Binding MetaLine}"
                                               FontFamily="JetBrainsMono"
                                               FontSize="9"
                                               CharacterSpacing="1.2"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{StaticResource UgBlood}" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2"
                                                           Spacing="6"
                                                           VerticalOptions="Center">
                                        <Label Text="{Binding CountDisplay}"
                                               FontFamily="BebasNeue"
                                               FontSize="28"
                                               TextColor="{StaticResource UgInk}"
                                               VerticalOptions="Center" />
                                        <Label Text="SES"
                                               Style="{StaticResource UgMono}"
                                               FontSize="9"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Row 4: bottom action bar — pinned. -->
        <Border Grid.Row="4"
                Padding="16,10,16,16"
                BackgroundColor="{StaticResource UgPaper}"
                Stroke="{StaticResource UgInk}"
                StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border Grid.Column="0"
                        Padding="10,8"
                        BackgroundColor="{StaticResource UgTape}"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Label x:Name="LastSyncLabel"
                           FontFamily="JetBrainsMonoBold"
                           FontSize="10"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource UgInk}"
                           Text="LAST SYNC · --:--" />
                </Border>

                <Button Grid.Column="1"
                        Style="{StaticResource UgPrimaryButton}"
                        Text="+ НОВАЯ ГРУППА"
                        Clicked="OnAddGroupClicked" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
