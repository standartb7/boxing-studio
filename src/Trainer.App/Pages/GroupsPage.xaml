<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Trainer.App.ViewModels"
             xmlns:entities="clr-namespace:Trainer.Core.Entities;assembly=Trainer.Core"
             x:Class="Trainer.App.Pages.GroupsPage"
             Title="Группы"
             NavigationPage.BackButtonTitle="Назад">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Бэкап" Order="Secondary" Clicked="OnBackupClicked" />
        <ToolbarItem Text="+ Группа" Clicked="OnAddGroupClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- HeadTrainer trainer filter — hidden for regular trainers. -->
        <Border x:Name="TrainerFilterBar"
                Grid.Row="0"
                Padding="12,8"
                Margin="12,12,12,0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="Тренер:"
                       FontSize="13"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Picker Grid.Column="1"
                        x:Name="TrainerPicker"
                        FontSize="14"
                        SelectedIndexChanged="OnTrainerPickerChanged" />
            </Grid>
        </Border>

        <CollectionView x:Name="GroupsList"
                        Grid.Row="1"
                        Margin="12,16,12,12"
                        SelectionMode="Single"
                        SelectionChanged="OnGroupSelected">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
        </CollectionView.ItemsLayout>
        <CollectionView.EmptyView>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                <Label Text="Пока нет групп" FontSize="18" HorizontalTextAlignment="Center" />
                <Label Text="Нажми «+ Группа», чтобы создать первую" TextColor="Gray" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:GroupRow">
                <SwipeView Margin="0,4">
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Reveal">
                            <SwipeItem Text="Удалить"
                                       BackgroundColor="#D33"
                                       Invoked="OnDeleteGroupInvoked" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Border Padding="16"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="{Binding Type.Name}"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                            <Border Grid.Column="1"
                                    Padding="10,4"
                                    BackgroundColor="{StaticResource Accent}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Count}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Black}" />
                            </Border>
                        </Grid>
                    </Border>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

    </Grid>

</ContentPage>
