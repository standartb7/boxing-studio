<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entities="clr-namespace:Trainer.Core.Entities;assembly=Trainer.Core"
             x:Class="Trainer.App.Pages.ClientPickerPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource UgPaper}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Row 0: dark top strip with Отмена / + Новый -->
        <Grid Grid.Row="0"
              Padding="16,12,16,10"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{StaticResource UgInk}">
            <Button Grid.Column="0"
                    Text="← ОТМЕНА"
                    FontFamily="JetBrainsMonoBold"
                    FontSize="9"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource UgPaper}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0,0,12,0"
                    MinimumHeightRequest="22"
                    Clicked="OnCancelClicked" />
            <Label Grid.Column="1"
                   FontFamily="JetBrainsMono"
                   FontSize="9"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource UgPaper}"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   Text="ВЫБОР УЧАСТНИКА · PICK FIGHTER" />
            <Button Grid.Column="2"
                    Text="+ НОВЫЙ"
                    FontFamily="JetBrainsMonoBold"
                    FontSize="9"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource UgBlood}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="12,0,0,0"
                    MinimumHeightRequest="22"
                    Clicked="OnCreateNewClicked" />
        </Grid>

        <!-- Row 1: hero -->
        <VerticalStackLayout Grid.Row="1" Padding="20,14,20,10" Spacing="2">
            <Label Style="{StaticResource UgMono}" Text="РЕЕСТР · ROSTER" />
            <Label Style="{StaticResource UgDisplay}"
                   FontSize="42"
                   Text="FIGHTERS" />
        </VerticalStackLayout>

        <!-- Row 2: search -->
        <Border Grid.Row="2"
                Style="{StaticResource UgFieldBorder}"
                Margin="16,0,16,8">
            <Entry x:Name="SearchBox"
                   Style="{StaticResource UgEntry}"
                   Placeholder="FIND ▸ имя…"
                   TextChanged="OnSearchTextChanged"
                   ClearButtonVisibility="WhileEditing" />
        </Border>

        <!-- Row 3: error banner -->
        <Border Grid.Row="3"
                x:Name="ErrorBanner"
                Margin="16,0,16,8"
                Padding="12,8"
                BackgroundColor="{StaticResource UgBlood}"
                StrokeThickness="0"
                IsVisible="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0"
                       x:Name="ErrorText"
                       FontFamily="JetBrainsMonoBold"
                       FontSize="11"
                       TextColor="{StaticResource UgPaper}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="ПОВТОР"
                        FontFamily="JetBrainsMonoBold"
                        FontSize="10"
                        CharacterSpacing="1.2"
                        Padding="10,4"
                        MinimumHeightRequest="28"
                        BackgroundColor="{StaticResource UgPaper}"
                        TextColor="{StaticResource UgInk}"
                        BorderWidth="0"
                        CornerRadius="2"
                        Clicked="OnRetryClicked" />
            </Grid>
        </Border>

        <!-- Row 4: clients list -->
        <CollectionView x:Name="ClientsList"
                        Grid.Row="4"
                        SelectionMode="Single"
                        SelectionChanged="OnClientSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="24">
                    <Label Text="НЕТ ПОДХОДЯЩИХ"
                           FontFamily="BebasNeue"
                           FontSize="32"
                           CharacterSpacing="1"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource UgInk}" />
                    <Label Style="{StaticResource UgMono}"
                           Text="НАЖМИ «+ НОВЫЙ» В ВЕРХНЕМ ПРАВОМ"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:Client">
                    <Border BackgroundColor="{StaticResource UgPaper}"
                            StrokeThickness="0"
                            Padding="0">
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="16,12,16,12">
                            <BoxView Grid.ColumnSpan="2"
                                     HeightRequest="1"
                                     Color="{StaticResource UgInk}"
                                     VerticalOptions="Start"
                                     Margin="-16,0,-16,0"
                                     Opacity="0.35" />

                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontFamily="BebasNeue"
                                       FontSize="18"
                                       CharacterSpacing="0.5"
                                       LineBreakMode="WordWrap"
                                       TextColor="{StaticResource UgInk}" />
                                <Label Text="{Binding Phone}"
                                       FontFamily="JetBrainsMono"
                                       FontSize="10"
                                       CharacterSpacing="1.0"
                                       TextColor="{StaticResource UgBlood}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="1"
                                   Text="→"
                                   FontFamily="JetBrainsMonoBold"
                                   FontSize="16"
                                   TextColor="{StaticResource UgInkMuted}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
