<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entities="clr-namespace:Trainer.Core.Entities;assembly=Trainer.Core"
             x:Class="Trainer.App.Pages.ClientPickerPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="0">

        <!-- Кастомный header: Отмена слева, заголовок по центру, + Новый справа -->
        <Grid Grid.Row="0"
              Padding="16,12"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

            <Button Grid.Column="0"
                    Text="Отмена"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                    BorderWidth="0"
                    Padding="0"
                    FontSize="15"
                    MinimumHeightRequest="32" />

            <Label Grid.Column="1"
                   Text="Выбор участника"
                   FontAttributes="Bold"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

            <Button Grid.Column="2"
                    Text="+ Новый"
                    Clicked="OnCreateNewClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Accent}"
                    BorderWidth="0"
                    Padding="0"
                    FontSize="15"
                    FontAttributes="Bold"
                    MinimumHeightRequest="32" />
        </Grid>

        <!-- Search field: Entry в светлой обёртке, без нативного тёмного фона SearchBar -->
        <Border Grid.Row="1"
                Margin="12,0,12,8"
                Padding="12,4"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Entry x:Name="SearchBox"
                   Placeholder="Поиск по имени"
                   TextChanged="OnSearchTextChanged"
                   ClearButtonVisibility="WhileEditing"
                   BackgroundColor="Transparent"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                   PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Border>

        <CollectionView x:Name="ClientsList"
                        Grid.Row="2"
                        Margin="12,0,12,12"
                        SelectionMode="Single"
                        SelectionChanged="OnClientSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6" Padding="24">
                    <Label Text="Нет подходящих клиентов" FontSize="16" HorizontalTextAlignment="Center" />
                    <Label Text="Нажми «+ Новый», чтобы создать" TextColor="Gray" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:Client">
                    <Border Padding="14"
                            Margin="0,4"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                            <Label Text="{Binding Phone}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
