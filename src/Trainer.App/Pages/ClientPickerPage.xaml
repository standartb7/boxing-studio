<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entities="clr-namespace:Trainer.Core.Entities;assembly=Trainer.Core"
             x:Class="Trainer.App.Pages.ClientPickerPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0">

        <!-- Кастомный header: Отмена слева, заголовок по центру, + Новый справа -->
        <Grid Grid.Row="0"
              Padding="16,12"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

            <Button Grid.Column="0"
                    Text="Отмена"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                    BorderWidth="0"
                    Padding="0"
                    FontSize="15"
                    MinimumHeightRequest="32" />

            <Label Grid.Column="1"
                   Text="Выбор участника"
                   FontAttributes="Bold"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

            <Button Grid.Column="2"
                    Text="+ Новый"
                    Clicked="OnCreateNewClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Accent}"
                    BorderWidth="0"
                    Padding="0"
                    FontSize="15"
                    FontAttributes="Bold"
                    MinimumHeightRequest="32" />
        </Grid>

        <Border x:Name="ErrorBanner"
                Grid.Row="1"
                Padding="12,8"
                Margin="12,4,12,4"
                StrokeThickness="0"
                BackgroundColor="#FFE2E2"
                IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0" x:Name="ErrorText" FontSize="13" TextColor="#8B0000" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Повторить" FontSize="13" Padding="12,4"
                        BackgroundColor="#8B0000" TextColor="White" Clicked="OnRetryClicked" />
            </Grid>
        </Border>

        <Entry x:Name="SearchBox"
               Grid.Row="2"
               Margin="12,0,12,8"
               Placeholder="Поиск по имени"
               TextChanged="OnSearchTextChanged"
               ClearButtonVisibility="WhileEditing"
               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
               PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

        <CollectionView x:Name="ClientsList"
                        Grid.Row="3"
                        Margin="12,0,12,12"
                        SelectionMode="Single"
                        SelectionChanged="OnClientSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6" Padding="24">
                    <Label Text="Нет подходящих клиентов" FontSize="16" HorizontalTextAlignment="Center" />
                    <Label Text="Нажми «+ Новый», чтобы создать" TextColor="Gray" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="entities:Client">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Передать"
                                           BackgroundColor="#1976D2"
                                           Invoked="OnReassignSwipe"
                                           IsVisible="{Binding CanReassign}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Padding="14"
                                Margin="0,4"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                <Label Text="{Binding Phone}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding OwnerDisplayName, StringFormat='тренер: {0}'}"
                                       FontSize="11"
                                       FontAttributes="Italic"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding OwnerDisplayName}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
