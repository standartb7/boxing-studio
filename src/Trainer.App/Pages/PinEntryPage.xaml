<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Trainer.App.Pages.PinEntryPage"
             NavigationPage.HasNavigationBar="False"
             ios:Page.UseSafeArea="False"
             BackgroundColor="{StaticResource UgPaper}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              Padding="{StaticResource UgTopStripPadding}"
              BackgroundColor="{StaticResource UgInk}">
            <Label FontFamily="JetBrainsMono"
                   FontSize="9"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource UgPaper}"
                   VerticalOptions="Center"
                   Text="EST. MMXIX  •  BOXING STUDIO  •  CHECKPOINT  •  PIN" />
        </Grid>

        <VerticalStackLayout Grid.Row="1"
                             Padding="24"
                             Spacing="14"
                             MaximumWidthRequest="360"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <Label Style="{StaticResource UgMono}"
                   Text="БЫСТРЫЙ ВХОД · CHECKPOINT"
                   HorizontalOptions="Center" />
            <Label Style="{StaticResource UgDisplay}"
                   FontSize="64"
                   HorizontalOptions="Center"
                   Text="PIN" />
            <Label Style="{StaticResource UgMono}"
                   Text="ВВЕДИ СВОЙ 4-ЗНАЧНЫЙ КОД"
                   HorizontalOptions="Center"
                   Margin="0,4,0,12" />

            <Border Style="{StaticResource UgFieldBorder}"
                    WidthRequest="240"
                    HorizontalOptions="Center">
                <Entry x:Name="PinEntry"
                       Style="{StaticResource UgEntry}"
                       Placeholder="• • • •"
                       Keyboard="Numeric"
                       MaxLength="4"
                       IsPassword="True"
                       HorizontalTextAlignment="Center"
                       FontSize="28"
                       CharacterSpacing="8"
                       TextChanged="OnPinTextChanged" />
            </Border>

            <Label x:Name="ErrorLabel"
                   FontFamily="JetBrainsMonoBold"
                   FontSize="11"
                   CharacterSpacing="0.8"
                   TextColor="{StaticResource UgBlood}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />

            <Button x:Name="BiometricBtn"
                    Style="{StaticResource UgGhostButton}"
                    Text="◆ FACE ID"
                    Clicked="OnBiometricClicked"
                    IsVisible="False"
                    HorizontalOptions="Center"
                    Margin="0,12,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
