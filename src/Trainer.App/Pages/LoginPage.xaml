<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Trainer.App.Pages.LoginPage"
             NavigationPage.HasNavigationBar="False"
             ios:Page.UseSafeArea="False"
             BackgroundColor="{StaticResource UgPaper}">

    <Grid RowDefinitions="Auto,*">

        <!-- Top dark mono strip -->
        <Grid Grid.Row="0"
              Padding="{StaticResource UgTopStripPadding}"
              BackgroundColor="{StaticResource UgInk}">
            <Label FontFamily="JetBrainsMono"
                   FontSize="9"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource UgPaper}"
                   VerticalOptions="Center"
                   Text="EST. MMXIX  •  BOXING STUDIO  •  ACCESS  •  REG. № 047" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,32,24,40"
                                 Spacing="14"
                                 MaximumWidthRequest="480"
                                 HorizontalOptions="Center">

                <!-- Hero -->
                <Label Style="{StaticResource UgMono}"
                       Text="ВХОД ДЛЯ ТРЕНЕРОВ · ACCESS"
                       Margin="0,8,0,0" />
                <Label Style="{StaticResource UgDisplay}"
                       FontSize="72"
                       Margin="0,-6,0,0"
                       Text="LOG IN" />

                <BoxView HeightRequest="1"
                         Color="{StaticResource UgInk}"
                         Margin="0,4,0,12" />

                <!-- Email -->
                <Label Style="{StaticResource UgFieldLabel}" Text="ЛОГИН · EMAIL" />
                <Border Style="{StaticResource UgFieldBorder}">
                    <Entry x:Name="EmailEntry"
                           Style="{StaticResource UgEntry}"
                           Keyboard="Email"
                           IsTextPredictionEnabled="False"
                           Placeholder="trainer@gym.com" />
                </Border>

                <!-- Password -->
                <Label Style="{StaticResource UgFieldLabel}"
                       Text="ПАРОЛЬ · PASSWORD"
                       Margin="0,6,0,0" />
                <Border Style="{StaticResource UgFieldBorder}">
                    <Entry x:Name="PasswordEntry"
                           Style="{StaticResource UgEntry}"
                           IsPassword="True"
                           Placeholder="••••••••" />
                </Border>

                <Button x:Name="LoginBtn"
                        Style="{StaticResource UgPrimaryButton}"
                        Text="✷ ВОЙТИ В РИНГ ✷"
                        Clicked="OnLoginClicked"
                        Margin="0,18,0,0" />

                <!-- Error -->
                <Label x:Name="ErrorLabel"
                       IsVisible="False"
                       FontFamily="JetBrainsMonoBold"
                       FontSize="11"
                       CharacterSpacing="0.8"
                       TextColor="{StaticResource UgBlood}"
                       Margin="0,6,0,0"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <ActivityIndicator x:Name="Spinner"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{StaticResource UgInk}"
                                   HorizontalOptions="Center"
                                   Margin="0,6,0,0" />

                <BoxView HeightRequest="1"
                         Color="{StaticResource UgInk}"
                         Opacity="0.4"
                         Margin="0,20,0,8" />

                <!-- Invite -->
                <Label Style="{StaticResource UgMono}"
                       Text="ПРИГЛАШЁН ГЛАВНЫМ ТРЕНЕРОМ?"
                       HorizontalOptions="Center" />
                <Button x:Name="AcceptInviteBtn"
                        Style="{StaticResource UgGhostButton}"
                        Text="→ ВВЕСТИ КОД ПРИГЛАШЕНИЯ"
                        Clicked="OnAcceptInviteClicked"
                        HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
