<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trainer.App.Pages.LoginPage"
             Title="Вход"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Label Text="TRAINER"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

            <Label Text="Вход в аккаунт"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                   Margin="0,0,0,16" />

            <Entry x:Name="EmailEntry"
                   Placeholder="Email"
                   Keyboard="Email"
                   ClearButtonVisibility="WhileEditing" />

            <Entry x:Name="PasswordEntry"
                   Placeholder="Пароль"
                   IsPassword="True" />

            <Label x:Name="ErrorLabel"
                   TextColor="Red"
                   FontSize="13"
                   IsVisible="False" />

            <Button x:Name="LoginBtn"
                    Text="Войти"
                    Clicked="OnLoginClicked"
                    Style="{StaticResource AccentButton}" />

            <Button Text="Создать аккаунт"
                    Clicked="OnRegisterClicked"
                    Style="{StaticResource OutlineButton}" />

            <ActivityIndicator x:Name="Loading"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
