<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trainer.App.Pages.LoginPage"
             Title="Вход"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#1A1A1A}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="16" MaximumWidthRequest="480" HorizontalOptions="Center">

            <Label Text="Boxing Studio" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Вход для тренеров" FontSize="14" Opacity="0.7" HorizontalOptions="Center" Margin="0,0,0,16" />

            <Label Text="Email" />
            <Entry x:Name="EmailEntry"
                   Keyboard="Email"
                   IsTextPredictionEnabled="False"
                   Placeholder="trainer@gym.test" />

            <Label Text="Пароль" Margin="0,8,0,0" />
            <Entry x:Name="PasswordEntry"
                   IsPassword="True"
                   Placeholder="Пароль" />

            <Button x:Name="LoginBtn"
                    Text="Войти"
                    Clicked="OnLoginClicked"
                    Margin="0,16,0,0" />

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="#D9534F"
                   Margin="0,8,0,0"
                   HorizontalOptions="Center" />

            <ActivityIndicator x:Name="Spinner"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0" />

            <BoxView HeightRequest="1" Color="#33888888" Margin="0,24,0,0" />

            <Button x:Name="AcceptInviteBtn"
                    Text="У меня есть код приглашения"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    Clicked="OnAcceptInviteClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
