<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="Trainer.App.Pages.ChangePasswordPage"
             NavigationPage.HasNavigationBar="False"
             ios:Page.UseSafeArea="False"
             BackgroundColor="{StaticResource UgPaper}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0"
              Padding="{StaticResource UgTopStripPadding}"
              ColumnDefinitions="Auto,*"
              BackgroundColor="{StaticResource UgInk}">
            <Button Grid.Column="0"
                    Text="← НАЗАД"
                    FontFamily="JetBrainsMonoBold"
                    FontSize="9"
                    CharacterSpacing="1.5"
                    TextColor="{StaticResource UgPaper}"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0,0,12,0"
                    MinimumHeightRequest="22"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   FontFamily="JetBrainsMono"
                   FontSize="9"
                   CharacterSpacing="1.5"
                   TextColor="{StaticResource UgPaper}"
                   VerticalOptions="Center"
                   Text="ACCOUNT  •  CHANGE PASSWORD  •  SECURITY" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,20,24,40"
                                 Spacing="12"
                                 MaximumWidthRequest="480"
                                 HorizontalOptions="Center">

                <Label Style="{StaticResource UgMono}" Text="БЕЗОПАСНОСТЬ · SECURITY" />
                <Label Style="{StaticResource UgDisplay}"
                       FontSize="48"
                       Text="СМЕНА ПАРОЛЯ" />

                <BoxView HeightRequest="1" Color="{StaticResource UgInk}" Margin="0,4,0,8" />

                <Label Style="{StaticResource UgFieldLabel}" Text="ТЕКУЩИЙ ПАРОЛЬ" />
                <Border Style="{StaticResource UgFieldBorder}">
                    <Entry x:Name="CurrentEntry"
                           Style="{StaticResource UgEntry}"
                           IsPassword="True"
                           Placeholder="••••••••" />
                </Border>

                <Label Style="{StaticResource UgFieldLabel}" Text="НОВЫЙ ПАРОЛЬ" Margin="0,6,0,0" />
                <Border Style="{StaticResource UgFieldBorder}">
                    <Entry x:Name="NewEntry"
                           Style="{StaticResource UgEntry}"
                           IsPassword="True"
                           Placeholder="МИНИМУМ 8 СИМВОЛОВ" />
                </Border>

                <Label Style="{StaticResource UgFieldLabel}" Text="ПОВТОРИ НОВЫЙ ПАРОЛЬ" Margin="0,6,0,0" />
                <Border Style="{StaticResource UgFieldBorder}">
                    <Entry x:Name="ConfirmEntry"
                           Style="{StaticResource UgEntry}"
                           IsPassword="True"
                           Placeholder="••••••••" />
                </Border>

                <Button x:Name="SaveBtn"
                        Style="{StaticResource UgPrimaryButton}"
                        Text="✷ СОХРАНИТЬ ✷"
                        Clicked="OnSaveClicked"
                        Margin="0,16,0,0" />

                <Label x:Name="ErrorLabel"
                       IsVisible="False"
                       FontFamily="JetBrainsMonoBold"
                       FontSize="11"
                       CharacterSpacing="0.8"
                       TextColor="{StaticResource UgBlood}"
                       Margin="0,8,0,0"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <ActivityIndicator x:Name="Spinner"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{StaticResource UgInk}"
                                   HorizontalOptions="Center"
                                   Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
