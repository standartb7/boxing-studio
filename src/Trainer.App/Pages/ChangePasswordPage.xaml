<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Trainer.App.Pages.ChangePasswordPage"
             Title="Сменить пароль"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="480" HorizontalOptions="Center">

            <Label Text="Текущий пароль" />
            <Entry x:Name="CurrentEntry"
                   IsPassword="True"
                   Placeholder="Текущий пароль" />

            <Label Text="Новый пароль" Margin="0,8,0,0" />
            <Entry x:Name="NewEntry"
                   IsPassword="True"
                   Placeholder="Минимум 8 символов" />

            <Label Text="Повтори новый пароль" Margin="0,8,0,0" />
            <Entry x:Name="ConfirmEntry"
                   IsPassword="True"
                   Placeholder="Повтори пароль" />

            <Button x:Name="SaveBtn"
                    Text="Сохранить"
                    Style="{StaticResource AccentButton}"
                    Clicked="OnSaveClicked"
                    Margin="0,16,0,0" />

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="#D9534F"
                   Margin="0,8,0,0"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <ActivityIndicator x:Name="Spinner"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
